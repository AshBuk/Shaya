# Install the binary only, the library target is internal to the crate
%global cargo_install_lib 0
%global app_id io.github.ashbuk.shaya

Name:           shaya
Version:        0.1.0
Release:        1%{?dist}
Summary:        Native AI assistant for Linux, built with Rust and GTK4
SourceLicense:  Apache-2.0
# Bundled crates, from the license summary printed in %%build
License:        Apache-2.0 AND BSD-3-Clause AND CDLA-Permissive-2.0 AND ISC AND MIT AND MPL-2.0 AND Unicode-3.0 AND (0BSD OR MIT OR Apache-2.0) AND (Apache-2.0 OR BSL-1.0) AND (Apache-2.0 OR ISC OR MIT) AND (Apache-2.0 OR MIT) AND (Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT) AND (MIT OR Zlib OR Apache-2.0) AND (Unlicense OR MIT)
URL:           https://github.com/AshBuk/Shaya
Source0:        %{url}/archive/refs/tags/v%{version}.tar.gz#/%{name}-%{version}.tar.gz
# Generated by create-srpm.sh, COPR and mock build without network access
Source1:        %{name}-%{version}-vendor.tar.xz

ExclusiveArch:  %{rust_arches}

BuildRequires:  cargo-rpm-macros
BuildRequires:  gcc
BuildRequires:  pkgconfig(gtk4)
BuildRequires:  pkgconfig(libadwaita-1)
BuildRequires:  pkgconfig(gtk4-layer-shell-0)
BuildRequires:  desktop-file-utils
BuildRequires:  appstream

# Audio capture
Recommends:     pipewire-utils
Recommends:     wireplumber
Suggests:       pulseaudio-utils
# Meeting recording encoder
Recommends:     opus-tools
Suggests:       /usr/bin/ffmpeg
# Screenshots on wlroots compositors, GNOME Wayland uses the portal
Recommends:     grim
Recommends:     slurp
Suggests:       spectacle
Suggests:       gnome-screenshot
Suggests:       scrot
# Opens the meetings folder
Recommends:     xdg-utils

%description
Shaya lives as an overlay on desktop and gives you instant access to AI chat,
voice transcription, screenshots, meeting recording and analysis.

Bring your own API key for Anthropic, OpenAI or Groq. There is no account and
no Shaya server: requests go directly to the provider you choose.

%prep
%autosetup -n Shaya-%{version} -a1
%cargo_prep -v vendor

%build
%cargo_build
%{cargo_license_summary}
%{cargo_license} > LICENSE.dependencies
%{cargo_vendor_manifest}

%install
%cargo_install
install -Dpm 0644 -t %{buildroot}%{_datadir}/applications assets/%{app_id}.desktop
install -Dpm 0644 -t %{buildroot}%{_metainfodir} assets/%{app_id}.metainfo.xml
install -Dpm 0644 icons/shaya.png %{buildroot}%{_datadir}/icons/hicolor/512x512/apps/%{app_id}.png
install -Dpm 0644 icons/shaya.svg %{buildroot}%{_datadir}/icons/hicolor/scalable/apps/%{app_id}.svg

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/%{app_id}.desktop
appstreamcli validate --no-net %{buildroot}%{_metainfodir}/%{app_id}.metainfo.xml
%cargo_test

%files
%license LICENSE LICENSE.dependencies cargo-vendor.txt
%doc README.md docs/OVERLAY_GUIDE.md
%{_bindir}/shaya
%{_datadir}/applications/%{app_id}.desktop
%{_metainfodir}/%{app_id}.metainfo.xml
%{_datadir}/icons/hicolor/512x512/apps/%{app_id}.png
%{_datadir}/icons/hicolor/scalable/apps/%{app_id}.svg

