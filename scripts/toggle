#!/usr/bin/env bash
# Toggle ShyQuiet visibility
# Usage: ./scripts/toggle (or bind to Win+S in Hyprland)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
BINARY="$PROJECT_ROOT/target/release/shyquiet"

# Check if ShyQuiet is running
PID=$(pgrep -f "$BINARY" 2>/dev/null | head -1)

if [ -n "$PID" ]; then
    # Running — send SIGUSR1 to toggle visibility
    kill -SIGUSR1 "$PID" 2>/dev/null
else
    # Not running — start it
    "$BINARY" &
fi
