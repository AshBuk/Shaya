# Shaya - View logs in real-time
LOG_FILE="${XDG_RUNTIME_DIR:-$HOME/.cache}/shaya/shaya.log"

if [ ! -f "$LOG_FILE" ]; then
    echo "Log file not found: $LOG_FILE"
    echo "Run with: ./dev debug"
    exit 1
fi

if [ ! -s "$LOG_FILE" ]; then
    echo "Log file is empty. Waiting for logs..."
fi

tail -f "$LOG_FILE"
