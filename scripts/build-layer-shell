#!/usr/bin/env bash
# Build gtk4-layer-shell 1.0.4+ from source
# Fixes GTK4 4.16+ compatibility issue (github.com/wmww/gtk4-layer-shell/issues/50)
#
# Installs to /usr/local (doesn't conflict with Fedora package)
# Easy to remove when Fedora updates to 1.0.4+

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

VERSION="1.0.4"
PREFIX="/usr/local"
LIBDIR="${PREFIX}/lib64"
BUILD_DIR="/tmp/gtk4-layer-shell-build"

show_help() {
    echo "Usage: $0 [install|uninstall|status]"
    echo ""
    echo "  install   - Build and install gtk4-layer-shell ${VERSION}"
    echo "  uninstall - Remove local installation"
    echo "  status    - Show current installation status"
    echo ""
    exit 0
}

show_status() {
    echo -e "${BLUE}=== gtk4-layer-shell Status ===${NC}"
    
    # Check pkg-config
    VERSION_PKG=$(pkg-config --modversion gtk4-layer-shell 2>/dev/null || echo "not found")
    echo -e "pkg-config version: ${GREEN}${VERSION_PKG}${NC}"
    
    # Check library locations
    echo -e "\nLibrary locations:"
    ldconfig -p 2>/dev/null | grep gtk4-layer-shell || echo "  (not in ldconfig)"
    
    # Check local installation
    if [ -f "${LIBDIR}/libgtk4-layer-shell.so" ]; then
        echo -e "\n${GREEN}✓ Local installation exists: ${LIBDIR}${NC}"
    else
        echo -e "\n${YELLOW}No local installation in ${LIBDIR}${NC}"
    fi
    
    # Check Fedora package
    RPM_VER=$(rpm -q --qf '%{VERSION}' gtk4-layer-shell 2>/dev/null || echo "not installed")
    echo -e "Fedora package: ${RPM_VER}"
}

do_uninstall() {
    echo -e "${BLUE}=== Uninstalling local gtk4-layer-shell ===${NC}"
    
    if [ ! -f "${LIBDIR}/libgtk4-layer-shell.so" ]; then
        echo -e "${YELLOW}No local installation found${NC}"
        exit 0
    fi
    
    echo -e "${YELLOW}Removing from ${PREFIX}...${NC}"
    sudo rm -f ${LIBDIR}/libgtk4-layer-shell*
    sudo rm -f ${LIBDIR}/pkgconfig/gtk4-layer-shell*.pc
    sudo rm -rf ${PREFIX}/include/gtk4-layer-shell
    sudo rm -f ${PREFIX}/share/gir-1.0/Gtk4LayerShell*.gir
    sudo rm -f ${LIBDIR}/girepository-1.0/Gtk4LayerShell*.typelib
    sudo rm -f ${PREFIX}/share/vala/vapi/gtk4-layer-shell*
    sudo ldconfig
    
    echo -e "${GREEN}✓ Uninstalled. Fedora package will be used now.${NC}"
    show_status
}

do_install() {
    echo -e "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║     Build gtk4-layer-shell ${VERSION} (GTK4 4.16+ fix)           ║${NC}"
    echo -e "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}"
    echo
    echo -e "${YELLOW}Install prefix: ${PREFIX}${NC}"
    echo -e "${YELLOW}Library dir:    ${LIBDIR}${NC}"
    echo

    # Check current version
    CURRENT=$(pkg-config --modversion gtk4-layer-shell 2>/dev/null || echo "not installed")
    echo -e "Current version: ${CURRENT}"
    echo -e "Target version:  ${VERSION}"
    echo

    # Install build dependencies
    echo -e "${BLUE}[1/4] Installing build dependencies...${NC}"
    sudo dnf install -y meson ninja-build wayland-devel wayland-protocols-devel \
        gtk4-devel gobject-introspection-devel vala git

    # Clone repo
    echo -e "${BLUE}[2/4] Fetching source...${NC}"
    rm -rf "$BUILD_DIR"
    git clone --depth 1 --branch "v${VERSION}" https://github.com/wmww/gtk4-layer-shell.git "$BUILD_DIR"
    cd "$BUILD_DIR"

    # Build
    echo -e "${BLUE}[3/4] Building...${NC}"
    meson setup build \
        --prefix="${PREFIX}" \
        --libdir="${LIBDIR}" \
        -Dexamples=false \
        -Ddocs=false \
        -Dtests=false
    ninja -C build

    # Install
    echo -e "${BLUE}[4/4] Installing to ${PREFIX}...${NC}"
    sudo ninja -C build install
    
    # Update ldconfig to prioritize /usr/local
    if ! grep -q "${LIBDIR}" /etc/ld.so.conf.d/*.conf 2>/dev/null; then
        echo -e "${YELLOW}Adding ${LIBDIR} to ldconfig...${NC}"
        echo "${LIBDIR}" | sudo tee /etc/ld.so.conf.d/local-lib64.conf
    fi
    sudo ldconfig

    # Verify
    NEW_VERSION=$(pkg-config --modversion gtk4-layer-shell 2>/dev/null || echo "failed")
    echo
    echo -e "${GREEN}═══════════════════════════════════════════════════════════════${NC}"
    if [ "$NEW_VERSION" = "$VERSION" ]; then
        echo -e "${GREEN}✓ gtk4-layer-shell ${VERSION} installed successfully!${NC}"
        echo
        echo -e "${YELLOW}To test Shaya stealth mode:${NC}"
        echo -e "  ./dev run"
        echo
        echo -e "${YELLOW}To uninstall later (when Fedora updates):${NC}"
        echo -e "  $0 uninstall"
    else
        echo -e "${RED}✗ Installation failed or version mismatch${NC}"
        echo -e "${YELLOW}  Expected: ${VERSION}, Got: ${NEW_VERSION}${NC}"
    fi
    echo -e "${GREEN}═══════════════════════════════════════════════════════════════${NC}"
    
    # Cleanup
    rm -rf "$BUILD_DIR"
}

# Main
case "${1:-install}" in
    install)  do_install ;;
    uninstall) do_uninstall ;;
    status)   show_status ;;
    -h|--help|help) show_help ;;
    *) echo "Unknown command: $1"; show_help ;;
esac
