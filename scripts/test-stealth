#!/usr/bin/env bash
# Test stealth mode visibility
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

err() { echo -e "${RED}✗ $1${NC}"; exit 1; }
ok() { echo -e "${GREEN}✓ $1${NC}"; }
warn() { echo -e "${YELLOW}⚠ $1${NC}"; }

echo "=== Shaya Stealth Test ==="
echo

# Check Wayland
[ "$XDG_SESSION_TYPE" = "wayland" ] || err "Not Wayland"
ok "Wayland"

# Check layer namespace
if hyprctl layers 2>/dev/null | grep -q "shaya-stealth"; then
    ok "Layer registered"
else
    warn "Layer not found (Shaya hidden or not running?)"
fi

# Check the layer rule in the config: one hl.layer_rule block, on any number of lines
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"
if awk 'BEGIN { RS = "hl\\.layer_rule" } /shaya-stealth/ && /no_screen_share *= *true/ { found = 1 } END { exit !found }' "$CONFIG" 2>/dev/null; then
    ok "Layer rule configured"
else
    warn "Add to $CONFIG (Hyprland 0.55 or later):"
    echo '  hl.layer_rule({ match = { namespace = "shaya-stealth" }, no_screen_share = true })'
fi

# Screenshot test
if command -v grim &>/dev/null && pgrep -f shaya >/dev/null; then
    # The whole screen is private: keep it readable by this user only.
    SHOT_DIR="${XDG_RUNTIME_DIR:-$HOME/.cache}/shaya"
    SHOT="$SHOT_DIR/stealth-test.png"
    (umask 077; mkdir -p "$SHOT_DIR"; grim "$SHOT" 2>/dev/null)
    ok "Screenshot: $SHOT"
    echo
    echo "Verify: Shaya should appear as BLACK RECTANGLE (not invisible)"
    echo "  xdg-open $SHOT"
fi
