#!/usr/bin/env bash
# Test stealth mode visibility
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

err() { echo -e "${RED}✗ $1${NC}"; exit 1; }
ok() { echo -e "${GREEN}✓ $1${NC}"; }
warn() { echo -e "${YELLOW}⚠ $1${NC}"; }

echo "=== ShyQuiet Stealth Test ==="
echo

# Check Wayland
[ "$XDG_SESSION_TYPE" = "wayland" ] || err "Not Wayland"
ok "Wayland"

# Check layer namespace
if hyprctl layers 2>/dev/null | grep -q "shyquiet-stealth"; then
    ok "Layer registered"
else
    warn "Layer not found (ShyQuiet not running?)"
fi

# Check layerrule in config
if grep -qE "no_screen_share.*shyquiet-stealth" ~/.config/hypr/hyprland.conf 2>/dev/null; then
    ok "Layerrule configured"
else
    warn "Add to hyprland.conf:"
    echo "  layerrule = no_screen_share on, match:namespace shyquiet-stealth"
fi

# Screenshot test
if command -v grim &>/dev/null && pgrep -f shyquiet >/dev/null; then
    grim /tmp/stealth-test.png 2>/dev/null
    ok "Screenshot: /tmp/stealth-test.png"
    echo
    echo "Verify: ShyQuiet should appear as BLACK RECTANGLE (not invisible)"
    echo "  xdg-open /tmp/stealth-test.png"
fi
